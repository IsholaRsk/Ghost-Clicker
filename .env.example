# Configuration locale ou modèle des variables Render.
# Ne publiez jamais le fichier .env.

# Passerelle Rayobyte rotative : une ligne username:password@host:port.
PROXY_GATEWAY_FILE="proxy-gateway.txt"

# Mot de passe de l'interface web. L'utilisateur est toujours admin.
ADMIN_TOKEN=

HEADLESS=true
NAVIGATION_TIMEOUT_MS=30000
CLICK_TIMEOUT_MS=15000
REDIRECT_TIMEOUT_MS=30000
WAIT_AFTER_REDIRECT_SECONDS=2
DELAY_BETWEEN_TARGETS_SECONDS=3
SETTINGS_FILE="/tmp/ghost-clicker-settings.json"
REPORTS_FILE="/tmp/ghost-clicker-reports.json"

# Mode local main.py uniquement (facultatif).
TARGET_URL=
BUTTON_TEXT=
SECOND_BUTTON_TEXT=

# Configuration locale ou modèle des variables Render.
# Ne publiez jamais le fichier .env.

# Fichier actif généré et cache local privé des passerelles Rayobyte.
# La source durable est chiffrée dans Supabase Vault par l'interface.
# Une valeur saisie dans l'interface suit le format username:password@host:port.
PROXY_GATEWAY_FILE="proxy-gateway.txt"
PROXY_GATEWAYS_FILE="/tmp/ghost-clicker-proxy-gateways.json"

# Mot de passe de l'interface web. L'utilisateur est toujours admin.
ADMIN_TOKEN=

# Persistance Supabase. Utilisez uniquement une clé serveur dédiée dans Render.
# Ne placez jamais SUPABASE_SECRET_KEY dans Git, un fichier partagé ou le navigateur.
SUPABASE_URL="https://votre-projet.supabase.co"
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=10

HEADLESS=true
NAVIGATION_TIMEOUT_MS=30000
CLICK_TIMEOUT_MS=15000
REDIRECT_TIMEOUT_MS=30000
WAIT_AFTER_REDIRECT_SECONDS=2
DELAY_BETWEEN_TARGETS_SECONDS=3
SETTINGS_FILE="/tmp/ghost-clicker-settings.json"
REPORTS_FILE="/tmp/ghost-clicker-reports.json"

# Mode local main.py uniquement (facultatif).
TARGET_URL=
# Les deux libellés sont facultatifs : tous deux vides = visite sans clic.
BUTTON_TEXT=
# Vide avec BUTTON_TEXT renseigné = un clic ; renseigné = deux clics.
# Un second libellé sans premier est invalide.
SECOND_BUTTON_TEXT=
# fixed, range ou continuous.
EXECUTION_MODE="fixed"
REPETITION_COUNT=1
REPETITION_MIN=1
REPETITION_MAX=10

# Copiez ce fichier vers .env, puis remplacez uniquement les valeurs nécessaires.
# Ne publiez jamais le fichier .env et ne communiquez pas vos mots de passe.

# Données EXACTES affichées dans votre tableau de bord Rayobyte.
# Format Playwright : protocole://hote:port (sans utilisateur ni mot de passe).
# Laissez vide dans ce modèle : aucun endpoint Rayobyte n'est inventé ici.
RAYOBYTE_US_PROXY_SERVER=
RAYOBYTE_US_USERNAME=
RAYOBYTE_US_PASSWORD=

RAYOBYTE_CA_PROXY_SERVER=
RAYOBYTE_CA_USERNAME=
RAYOBYTE_CA_PASSWORD=

# Service JSON de vérification. ipinfo.io renvoie notamment "ip" et "country".
# Vérifiez ses limites et conditions d'utilisation avant un usage soutenu.
IP_CHECK_URL=https://ipinfo.io/json

# Chromium reste visible sous Windows comme demandé.
HEADLESS=false

# Délais en millisecondes.
PROXY_CHECK_TIMEOUT_MS=20000
NAVIGATION_TIMEOUT_MS=30000

# Pause raisonnable entre deux URL (secondes, décimales autorisées).
DELAY_BETWEEN_URLS_SECONDS=3

# Option de sécurité recommandée : domaines autorisés, séparés par des virgules,
# sans https:// ni chemin. Une valeur vide autorise tout domaine public de links.txt.
# Exemple : example.com,example.org
ALLOWED_DOMAINS=

# À ne mettre sur true que si votre fournisseur exige explicitement ce réglage.
IGNORE_HTTPS_ERRORS=false

# Nombre maximal de lignes affichées dans le HTML (le CSV conserve tout).
MAX_DASHBOARD_ROWS=2000

# Les valeurs suivantes sont normalement inutiles, mais permettent de changer
# les chemins sans modifier main.py.
LINKS_FILE=links.txt
PROXIES_FILE=proxies.txt
RESULTS_DIR=results

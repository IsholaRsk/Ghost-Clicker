# Copiez ces clés dans Render > Environment. Ne publiez jamais les vraies valeurs.
# Render n'importe pas automatiquement ce fichier : il sert de modèle de saisie.

RAYOBYTE_US_PROXY_SERVER="http://us-east.gw.rayobyte.com:8000"
RAYOBYTE_US_USERNAME=
# Collez ici le mot de passe complet se terminant par -country-US.
RAYOBYTE_US_PASSWORD=

# Une URL par ligne (valeur multiligne Render) ou tableau JSON.
TARGET_URLS='["https://example.com/","https://example.org/"]'
# Domaines sans protocole, séparés par des virgules.
ALLOWED_DOMAINS="example.com,example.org"

# Mot de passe de l'interface web. Utilisateur HTTP Basic : admin
ADMIN_TOKEN=

HEADLESS=true
PROXY_POOL_SIZE=100
MAX_PROXIES_PER_RUN=10
DELAY_BETWEEN_URLS_SECONDS=3
PROXY_CHECK_TIMEOUT_MS=20000
NAVIGATION_TIMEOUT_MS=30000
IP_CHECK_URL="https://ipinfo.io/json"
IGNORE_HTTPS_ERRORS=false
MAX_DASHBOARD_ROWS=2000
RESULTS_DIR="/tmp/ghost-clicker-results"
PROXIES_FILE="/tmp/ghost-clicker-proxies.txt"
ZIP_CODES_FILE="/app/zip_codes_us.txt"
